DATABASE_URL=postgres://postgres:postgres@localhost:5432/fpt_exam_centre
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
APP_BASE_URL=http://localhost:5173
PORT=4000

# Bootstrap administrator, created by `npm run db:seed` if no administrator exists yet.
ADMIN_NAME=FPT Academy Admin
ADMIN_EMAIL=admin@fptacademy.co.za
ADMIN_PASSWORD=change-me-before-first-run

# Object storage (Cloudflare R2) - not wired up yet in this Phase 1 scaffold, placeholders for later phases.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI engines - not wired up yet in this Phase 1 scaffold.
ANTHROPIC_API_KEY=
