DATABASE_URL=postgres://postgres:postgres@localhost:5432/fpt_exam_centre
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
APP_BASE_URL=http://localhost:5173
PORT=4000

# Bootstrap administrator, created by `npm run db:seed` if no administrator exists yet.
ADMIN_NAME=FPT Academy Admin
ADMIN_EMAIL=admin@fptacademy.co.za
ADMIN_PASSWORD=change-me-before-first-run
# Authenticator (two-step) sign-in for supervisory roles is OFF until this is set to yes - set it before real sittings.
# MFA_REQUIRED=yes
# Recovery switch for the owner: set ADMIN_RECOVER=yes, restart, sign in with ADMIN_PASSWORD (no authenticator), then remove it.
# ADMIN_RECOVER=

# Object storage (Cloudflare R2) - not wired up yet in this Phase 1 scaffold, placeholders for later phases.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# AI engines - not wired up yet in this Phase 1 scaffold.
ANTHROPIC_API_KEY=

# Curricula Builder connection (docs/curricula-builder-contract.md). Until both are set
# the QCTO and "other course" routes under Set up an Assessment show "not connected yet".
# CURRICULA_BUILDER_BASE_URL=https://curriculabuilder.example
# CURRICULA_BUILDER_API_KEY=

# Outgoing email (set-up links to newly registered people; later, notifications).
# Until set, links are shown to the Administrator to send by hand.
# Microsoft 365: SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_USER=mailbox address  SMTP_PASS=its password / app password
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="FPT Exam <exams@fptacademy.co.za>"
