entrypoint = "server/src/index.ts"
modules = ["nodejs-20", "postgresql-16"]

# Clicking "Run" in the Replit editor uses this. It mirrors [deployment] below:
# a full rebuild then a single Express process serving the built client AND
# the API on one port. Slower per click than a dev server would be, but it's
# the same one-port setup the workspace is wired for (see README "Production
# build" section), so there's nothing extra to configure.
run = "npm run build && npm start"

[nix]
channel = "stable-24_05"

[deployment]
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[[ports]]
localPort = 4000
externalPort = 80

[env]
NODE_ENV = "production"
